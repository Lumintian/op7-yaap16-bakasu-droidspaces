# Droidspaces hardware-access prerequisite. Do not auto-mount devtmpfs on Android host boot.
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set

# ReSukiSU: built in, deterministic identity, manual hooks for legacy Linux 4.14.
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_TOOLKIT_SUPPORT is not set
CONFIG_KSU_FULL_NAME_FORMAT="%COMMIT_SHA%@%REPO_NAME%"
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_SUSFS is not set

# These upstream-supported auto hooks avoid extra syscall/input source patches on 4.14.
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
